# ค่าตั้งของหน้าสถานะระบบ KohKae (statusprogram)
# แก้แล้วต้องเปิดหน้าสถานะใหม่ (กดปิดพอร์ต 8090 ตัวเฝ้าจะเปิดกลับเอง) — ยกเว้นส่วนอีเมล อ่านใหม่เองทุก 10 วิ
# ลบบรรทัดไหนออก = ใช้ค่าเริ่มต้นในโค้ด

# ----- หน้าสถานะเอง -----
STATUS_PORT=8090
# 127.0.0.1 = เปิดได้เฉพาะเครื่องนี้ · 0.0.0.0 = เครื่องอื่นในวงแลนเปิดได้ (ควรมีหน้าเข้าสู่ระบบก่อน)
STATUS_HOST=127.0.0.1

# ----- โฟลเดอร์ที่เกี่ยวข้อง (เว้นว่าง = โฟลเดอร์ข้างกันบน Desktop) -----
MYPROJECT_DIR=
CHECKPROGRAM_DIR=

# ----- ส่วนที่ไปเช็ค -----
SERVICE_HOST=127.0.0.1
SCAN_PORT=8000
API_PORT=5000
WEB_PORT=5173
# ใช้แสดงบนการ์ดเท่านั้น ที่อยู่ฐานข้อมูลจริงอยู่ใน Myproject\database\.env
ORACLE_PORT_LABEL=1521

# ----- เช็คถี่แค่ไหน (มิลลิวินาที) -----
CHECK_SCAN_MS=1000
CHECK_API_MS=2000
CHECK_ORACLE_MS=5000
CHECK_SLOW_MS=30000

# ----- เกณฑ์ -----
# ไม่ตอบนานกี่วินาทีถึงเป็นสีแดง (และส่งอีเมล)
DOWN_AFTER_SECONDS=60
# ดิสก์ C: เหลือน้อยกว่านี้ = เหลือง / แดง
DISK_WARN_GB=15
DISK_DOWN_GB=5
# ไฟล์สำรองล่าสุดเก่ากว่ากี่วัน = เหลือง
BACKUP_MAX_AGE_DAYS=1
# ปุ่ม "เปิดใหม่" ส่วนเดิม กดซ้ำได้หลังกี่วินาที
RESTART_GAP_SECONDS=30

# ----- กล้อง (เช็คตรงทางเครือข่าย: แค่ลองต่อแล้วปิด ไม่แย่งภาพกับส่วนสแกน) -----
# เว้นว่าง = ไม่เช็คทางเครือข่าย
CAMERA_HOST=192.168.88.120
CAMERA_PORT=554

# ----- ตรวจคุณภาพภาพกล้อง -----
IMAGE_CHECK_ENABLED=true
IMAGE_CHECK_SECONDS=10
# ความสว่างเฉลี่ย 0-255: ต่ำกว่านี้ = ภาพมืดสนิท / สูงกว่านี้ = ขาวจ้า (กลางวันปกติ ~110)
IMAGE_DARK_MIN=12
IMAGE_BRIGHT_MAX=245
# ความต่างของสีในภาพ: ต่ำกว่านี้ = สีเดียวทั้งจอ เช่น เลนส์ถูกบัง (ปกติ ~51)
IMAGE_FLAT_MIN=5
# ความคม: ต่ำกว่านี้ = เบลอ (กลางวันปกติ ~4700) · 0 = ไม่เช็ค
IMAGE_BLUR_MIN=300
# ภาพเดิมซ้ำนานกี่วินาที = ภาพค้าง
IMAGE_FROZEN_SECONDS=60

# ----- ซ่อมตัวเอง (true/false ทีละเรื่อง) -----
# ภาพค้าง/ดำ/ไม่เข้า ทั้งที่ส่วนสแกนยังตอบ → เปิดส่วนสแกนใหม่
HEAL_CAMERA=true
HEAL_CAMERA_AFTER_SECONDS=60
# ฐานข้อมูลไม่ตอบ → เปิด Oracle ใหม่ (ต้องรัน install_oracle_restart.bat แบบ Run as administrator 1 ครั้งก่อน)
HEAL_ORACLE=true
HEAL_ORACLE_AFTER_SECONDS=120
# ไฟล์สำรองล่าสุดเก่าเกินกำหนด → สำรองซ้ำ หลังกี่โมงเช้า
HEAL_BACKUP=true
HEAL_BACKUP_HOUR=6
# ดิสก์ใกล้เต็ม → ย้ายภาพเก่าไปโฟลเดอร์พัก (ไม่ลบ) · ต้องเป็นไดรฟ์อื่นที่ไม่ใช่ C: ถึงจะได้ที่คืน
# ระวัง: ภาพที่ย้ายไปแล้ว หน้าประวัติของระบบหลักจะเปิดภาพนั้นไม่ขึ้น
HEAL_DISK=true
IMAGE_ARCHIVE_DIR=
IMAGE_ARCHIVE_DAYS=90
# ปัญหารอบเดียว ลองซ่อมได้กี่ครั้ง ห่างกันกี่นาที แล้วหยุดรอคน
HEAL_MAX_TRIES=2
HEAL_RETRY_MINUTES=5

# ----- อีเมลแจ้งเตือน -----
# แจ้งทุกส่วนที่เป็นสีแดง + ดิสก์/สำรองข้อมูลตั้งแต่เหลือง · App Password 16 หลัก สร้างที่ myaccount.google.com/apppasswords
# (เว้น EMAIL_SENDER ว่าง = ใช้ชุดเดิมใน checkprogram\.env)
EMAIL_ENABLED=true
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_TO=
# ส่วนเดิมแจ้งซ้ำได้หลังกี่นาที (เว้นว่าง = ตาม checkprogram\.env)
ALERT_COOLDOWN_MINUTES=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
